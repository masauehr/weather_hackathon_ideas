# .env.example — 実際のキーは書かず、コピーして .env を作ること（.env は .gitignore 済み）
# 使い方: cp .env.example .env  →  .env に実際の値を記入

# Claude API キー（experiments/cs32_chart_vlm/vlm_read.py で使用）
# 取得: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ODPT（公共交通オープンデータ）APIキー（experiments/id37_bus_delay_weather/ で使用）
# 取得: https://developer.odpt.org/
ODPT_API_KEY=
